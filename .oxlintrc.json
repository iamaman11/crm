{
  "plugins": [
    "typescript",
    "import"
  ],
  "overrides": [
    {
      "files": [
        "apps/cloudflare-crm/web/src/**/*.ts",
        "apps/cloudflare-crm/web/src/**/*.tsx",
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx",
        "packages/client/src/cloudflare*.ts",
        "packages/client/src/cloudflare*/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": true,
            "ts-ignore": true,
            "ts-nocheck": true,
            "ts-check": true
          }
        ],
        "typescript/no-require-imports": "error",
        "no-eval": "error",
        "no-implied-eval": "error",
        "no-new-func": "error",
        "no-restricted-globals": [
          "error",
          "fetch",
          "XMLHttpRequest",
          "WebSocket",
          "EventSource",
          "eval",
          "Function",
          "require"
        ],
        "no-restricted-properties": [
          "error",
          {
            "property": "fetch",
            "message": "CRM browser network access belongs to the generated Connect client only"
          },
          {
            "property": "XMLHttpRequest",
            "message": "No direct browser transport outside the CRM client"
          },
          {
            "property": "WebSocket",
            "message": "No direct browser transport outside the CRM client"
          },
          {
            "property": "EventSource",
            "message": "No direct browser transport outside the CRM client"
          },
          {
            "property": "sendBeacon",
            "message": "No alternative browser transport"
          }
        ],
        "import/no-dynamic-require": [
          "error",
          {
            "esmodule": true
          }
        ]
      }
    },
    {
      "files": [
        "apps/cloudflare-crm/web/src/**/*.ts",
        "apps/cloudflare-crm/web/src/**/*.tsx"
      ],
      "rules": {
        "import/no-relative-parent-imports": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ultimate-crm/client",
                "message": "Use @ultimate-crm/client/cloudflare"
              }
            ],
            "patterns": [
              {
                "group": [
                  "@connectrpc/*",
                  "@bufbuild/*",
                  "@ultimate-crm/client/*",
                  "!@ultimate-crm/client/cloudflare",
                  "**/packages/client/**",
                  "**/packages/ui/**",
                  "**/gateway",
                  "**/gateway.*",
                  "**/transport",
                  "**/transport.*"
                ],
                "message": "CRM UI must use its public generated Connect client, not protocol, legacy transport or private workspace source"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx"
      ],
      "rules": {
        "import/no-relative-parent-imports": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ultimate-crm/client",
                "message": "Shared UI cannot import legacy gateway"
              },
              {
                "name": "@ultimate-crm/client/cloudflare",
                "message": "Shared UI cannot own the CRM client"
              }
            ],
            "patterns": [
              {
                "group": [
                  "@ultimate-crm/client/*",
                  "@connectrpc/*",
                  "@bufbuild/*",
                  "**/packages/client/**",
                  "**/gateway",
                  "**/gateway.*",
                  "**/transport",
                  "**/transport.*"
                ],
                "message": "Shared UI components must not own CRM networking"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/client/src/cloudflare*.ts",
        "packages/client/src/cloudflare*/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@connectrpc/connect-web",
                "importNames": [
                  "createGrpcWebTransport"
                ],
                "message": "Active CRM client must use only binary createConnectTransport"
              }
            ],
            "patterns": [
              {
                "group": [
                  "./gateway",
                  "../gateway",
                  "./transport",
                  "../transport",
                  "./crm",
                  "../crm",
                  "./index",
                  "../index",
                  "**/gateway",
                  "**/transport",
                  "**/gen/crm/gateway/**",
                  "**/gen/crm/**/v1/**"
                ],
                "message": "Active CRM client must not import retired gateway or v1 wire"
              }
            ]
          }
        ]
      }
    }
  ]
}
