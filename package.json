{
  "name": "ultimate-crm-product-plane",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "contracts:generate": "python scripts/generate_contract_bindings.py --write",
    "web:generate": "buf generate --template buf.gen.web.yaml && python scripts/generate_contract_bindings.py --write && cargo run -p crm-proto-contracts --bin generate_hashes -- packages/client/src/contract_hashes.ts",
    "gen": "pnpm web:generate",
    "gen:diff": "git diff --exit-code contracts/module-contract-bindings.json packages/client/src/contract_hashes.ts",
    "web:typecheck": "pnpm web:generate && pnpm -r --if-present typecheck",
    "web:lint": "pnpm -r --if-present lint",
    "web:test": "pnpm -r --if-present test",
    "web:build": "pnpm web:generate && pnpm --filter @ultimate-crm/web build",
    "web:check": "pnpm web:typecheck && pnpm web:lint && pnpm web:test && pnpm web:build"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
