{
  "name": "ultimate-crm-product-plane",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "web:generate": "buf generate --template buf.gen.web.yaml",
    "gen": "pnpm web:generate",
    "web:typecheck": "pnpm web:generate && pnpm -r --if-present typecheck",
    "web:lint": "pnpm exec oxlint -c .oxlintrc.json apps/cloudflare-crm/web/src packages/client/src packages/ui/src",
    "web:test": "pnpm -r --if-present test",
    "web:build": "pnpm web:generate && pnpm --filter cloudflare-crm build",
    "web:check": "node apps/cloudflare-crm/scripts/check-web.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "26.6.6",
    "binaryen": "132.0.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
