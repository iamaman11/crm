{
  "name": "ultimate-crm-product-plane",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "web:generate": "buf generate --template buf.gen.web.yaml",
    "gen": "pnpm web:generate",
    "web:typecheck": "pnpm web:generate && pnpm web:typecheck:active && pnpm web:typecheck:tools",
    "web:lint": "pnpm exec oxlint -c .oxlintrc.json apps/cloudflare-crm/web/src packages/client/src packages/ui/src",
    "web:test": "pnpm web:test:contracts && pnpm web:test:client && pnpm --filter cloudflare-crm test",
    "web:build": "pnpm web:generate && pnpm --filter cloudflare-crm build",
    "web:check": "pnpm web:typecheck:tools && node apps/cloudflare-crm/scripts/check-web.mts",
    "web:typecheck:active": "pnpm --recursive --filter cloudflare-crm... --fail-if-no-match --workspace-concurrency=2 exec tsc -p tsconfig.json --noEmit",
    "web:typecheck:tools": "tsc -p apps/cloudflare-crm/tsconfig.tools.json --noEmit",
    "web:contract:lint": "buf format -d --exit-code proto && buf lint proto",
    "web:contract:compatibility": "buf breaking . --against .git#ref=2c5f20eeb4185d16d2edec957965d8d50ec3d756 --path proto/crm/core/v1/common.proto --path proto/crm/activities/v1/task.proto --path proto/crm/sales/v1/deal.proto",
    "web:test:contracts": "node apps/cloudflare-crm/scripts/check-web.mts --node-tests \"scripts/crm-*.test.mjs\"",
    "web:test:client": "vitest run --config apps/cloudflare-crm/vitest.config.mts packages/client/src/"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "26.6.6",
    "binaryen": "132.0.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
