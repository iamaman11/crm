# Copy to deploy/.env, chmod 600, never commit.
# Set a real DNS hostname pointing to the host; Caddy acquires TLS automatically.
CRM_SITE_HOST=crm.example.com

# Generate independent secrets (example: openssl rand -hex 32).
# For the database URL, CRM_APP_DB_PASSWORD must contain hexadecimal characters only.
CRM_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
CRM_APP_DB_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
CRM_API_BEARER_TOKEN=REPLACE_WITH_RANDOM_64_HEX
CRM_CURSOR_SIGNING_KEY=REPLACE_WITH_RANDOM_64_HEX
CRM_APPROVAL_SIGNING_KEY=REPLACE_WITH_RANDOM_64_HEX

# Tenant and actor MUST exist in authoritative PostgreSQL state before admission.
CRM_API_TENANTS=REPLACE_TENANT_ID
CRM_API_ACTOR_ID=REPLACE_SERVICE_ACTOR_ID

# Example shape only. Generate an independent random password >= 32 characters.
# Do not use the placeholders in any real deployment.
CRM_PILOT_OPERATORS='[{"username":"REPLACE_USERNAME","password":"REPLACE_WITH_RANDOM_64_HEX","actor_id":"REPLACE_USER_ACTOR","tenant_id":"REPLACE_TENANT_ID","capabilities":["parties.party.create","parties.party.get","parties.party.list","parties.party.update","contact-points.contact-point.create","contact-points.contact-point.get","contact-points.contact-point.list","contact-points.contact-point.update","accounts.account.create","accounts.account.get","accounts.account.list","accounts.account.update","sales.deal.create","sales.deal.get","sales.deal.list","sales.deal.update","sales.deal.advance_stage","activities.task.create","activities.task.get","activities.task.list","activities.task.update","activities.task.complete"]}]'
