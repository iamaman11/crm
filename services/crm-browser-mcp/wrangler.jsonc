{
  "name": "crm-browser-mcp",
  "main": "./src/index.ts",
  "account_id": "5bd5e1e1e813f061afc259e91334262d",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "CrmBrowserSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CrmBrowserSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
