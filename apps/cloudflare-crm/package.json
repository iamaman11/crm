{
  "name": "cloudflare-crm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "node scripts/check-web.mts --node-tests \"test/**/*.node.test.mjs\" \"scripts/**/*.node.test.mjs\" && pnpm -w exec vitest run --config apps/cloudflare-crm/vitest.config.mts apps/cloudflare-crm/test/",
    "architecture:check": "node scripts/architecture-gate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@ultimate-crm/client": "workspace:*",
    "@ultimate-crm/ui": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "wrangler": "4.165.0",
    "playwright": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
