    {
      "id": "frontend",
      "owner": "product-platform",
      "path_patterns": [
        "apps/cloudflare-crm/web/**",
        "packages/client/**",
        "packages/ui/**",
        "buf.gen.web.yaml",
        "scripts/crm-architecture-ast.mjs",
        "scripts/crm-architecture-ast.test.mjs",
        "scripts/crm-rpc-descriptors.mjs"
      ],
      "required_workflows": [
        "Cloudflare CRM Spike CI"
      ]
