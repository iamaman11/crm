        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "packages/client/**",
        "packages/ui/**",
        "apps/cloudflare-crm/**",
        "scripts/crm-architecture-ast.mjs",
        "scripts/crm-architecture-ast.test.mjs",
        "scripts/crm-rpc-descriptors.mjs",
        "scripts/crm-module-coverage.py",
        "scripts/crm-active-rust-surface.py",
        "tests/test_crm_module_coverage.py",
        "tests/test_crm_active_rust_surface.py"
      ],
      "required_workflows": [
        "Cloudflare CRM Spike CI"
      ]
