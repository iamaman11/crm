        "scripts/crm-module-coverage.py",
        "scripts/crm-active-rust-surface.py",
        "tests/test_crm_module_coverage.py",
        "tests/test_crm_active_rust_surface.py",
        "scripts/affected_scope.py",
        "tests/test_affected_scope.py",
        "tests/test_local_lifecycle.py",
        "Makefile",
        "Cargo.toml",
        "README.md",
        "docs/DEVELOPMENT_WORKFLOW.md"
      ],
      "required_workflows": [
        "Cloudflare CRM Spike CI"
