{
  "schema_version": "crm.workspace-dependency-policy/v1",
  "policies": [
    {
      "id": "owner-module-common-serialization-and-hashing",
      "owner": "architecture-governance",
      "scope_glob": "modules/*/Cargo.toml",
      "dependencies": [
        "serde",
        "serde_json",
        "sha2"
      ],
      "enforcement": "blocking",
      "allow_local_features": false,
      "reason": "All current pure owner and link modules use the same existing serde, serde_json and sha2 requirements. Root inheritance prevents silent version or feature drift without forcing an unused dependency into a future module.",
      "tracking_issue": "#194"
    },
    {
      "id": "privacy-scope-adapter-contract-and-hashing",
      "owner": "architecture-governance",
      "scope_glob": "crates/*-privacy-scope-adapter/Cargo.toml",
      "dependencies": [
        "prost",
        "serde",
        "serde_json",
        "sha2"
      ],
      "enforcement": "blocking",
      "allow_local_features": false,
      "reason": "All nine accepted owner privacy-scope adapters use the existing prost 0.14 and sha2 0.10 requirements, while the only serde and serde_json consumer uses the existing root requirements. Root inheritance prevents contract, serialization or hashing drift without changing SQLx, Tokio or runtime behavior.",
      "tracking_issue": "#194"
    }
  ],
  "no_growth": {
    "id": "root-workspace-dependency-direct-debt-no-growth",
    "owner": "architecture-governance",
    "reason": "Freeze the exact remaining direct/non-inheriting consumers of every root workspace dependency family. Existing debt may only decrease; a new consumer or any version, feature, alias or source drift requires a complete expiring architecture exception.",
    "tracking_issue": "#194",
    "exception_rule": "workspace-dependency-no-growth",
    "dependency_families": [
      "prost",
      "serde",
      "serde_json",
      "sha2"
    ],
