{
  "business_module_globs": [
    "modules/*"
  ],
  "forbidden_dependencies": [
    "sqlx",
    "tokio-postgres",
    "postgres",
    "async-nats",
    "nats",
    "aws-sdk-s3",
    "object_store",
    "reqwest",
    "secrecy",
    "openai",
    "anthropic"
  ],
  "allowed_module_prefixes": [
    "crm-core-contracts",
    "crm-module-sdk"
  ],
  "sdk_crate_paths": [
    "crates/crm-module-sdk",
    "crates/crm-capability-runtime"
  ],
  "sdk_allowed_dependencies": [
    "crm-module-sdk",
    "serde"
  ],
  "forbidden_source_markers": [
    "sqlx::",
    "tokio_postgres",
    "async_nats",
    "aws_sdk_s3",
    "object_store::",
    "reqwest::",
    "secrecy::",
    "openai::",
    "anthropic::"
  ],
  "governed_transport_crates": {
    "services/crm-api": [
      "crm-application-runtime"
    ],
    "crates/crm-capability-ingress": [
      "crm-capability-runtime",
      "crm-module-sdk",
      "crm-query-runtime",
      "http",
      "sha2",
      "tokio",
      "tonic"
    ]
  },
  "governed_transport_forbidden_source_markers": [
    "crm_core_data",
    "crm_sales",
    "PostgresDataStore",
    "BatchMutationRuntime",
    "TransactionalCapabilityExecutor",
    "execute_batch("
  ],
  "restricted_dependency_consumers": {
    "crm-customer-privacy-owner-scope-support": [
      "crates/crm-consents-privacy-scope-adapter/Cargo.toml",
      "crates/crm-parties-privacy-scope-adapter/Cargo.toml"
    ]
  },
  "restricted_source_markers": {
    ".begin_bound_read_transaction(": [
      "crates/crm-consents-privacy-scope-adapter/src/postgres.rs",
      "crates/crm-parties-privacy-scope-adapter/src/postgres.rs"
    ]
  }
}
